# ==============================================================================
# BOOZER MOBILE · ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API URL (Use your LAN IP for physical device testing, e.g. http://192.168.1.10:8080/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Google Maps Platform API Key (Optional for development)
# Required for native Google Maps rendering on Android and traffic routing.
# On iOS, the app defaults to Apple Maps if no Google key is provided.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
