# ==============================================================================
# BOOZER WEB · ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API Endpoint
VITE_API_URL=https://boozer-backend.onrender.com/api/v1

# Map Provider API Keys (Optional)
# If none is provided, Boozer automatically falls back to high-resolution
# Vector Dark Canvas tiles with zero API key required.
#
# 1. Google Maps Platform (Recommended for India address precision & traffic ETAs):
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
#
# 2. CARTO Dark Matter (https://carto.com/basemaps):
# VITE_CARTO_API_KEY=your_carto_api_key_here
#
# 3. Mapbox Dark v11 (https://account.mapbox.com):
# VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
#
# 4. Stadia Maps Alidade Smooth Dark (https://stadiamaps.com):
# VITE_STADIA_API_KEY=your_stadia_api_key_here

# Google Firebase Phone Authentication (10,000 Free Real SMS OTPs / Month)
# Get free keys at: https://console.firebase.google.com/ -> Project Settings -> General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
