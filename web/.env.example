# ==============================================================================
# BOOZER WEB · ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API Endpoint
VITE_API_URL=https://boozer-backend.onrender.com/api/v1

# Map Provider API Keys (Optional)
# If none is provided, Boozer automatically falls back to Esri World Dark Gray
# Canvas tiles with zero watermark and zero rate limits.
#
# 1. CARTO Dark Matter (Free at https://carto.com/basemaps):
# VITE_CARTO_API_KEY=your_carto_api_key_here
#
# 2. Mapbox Dark v11 (Free at https://account.mapbox.com):
# VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
#
# 3. Stadia Maps Alidade Smooth Dark (Free at https://stadiamaps.com):
# VITE_STADIA_API_KEY=your_stadia_api_key_here
